{
  "rust-analyzer.linkedProjects": [
    "${workspaceFolder}/src/rust/Cargo.toml"
  ],
  "files.associations": {
    "Makevars": "makefile",
    "Makevars.in": "makefile",
    "Makevars.win": "makefile",
    "Makevars.win.in": "makefile",
    "configure": "shellscript",
    "configure.win": "shellscript",
    "cleanup": "shellscript",
    "cleanup.win": "shellscript"
  },
  "[quarto]": {
    "editor.defaultFormatter": "quarto.quarto",
    "editor.formatOnSave": true
  },
  "[r]": {
    "editor.defaultFormatter": "Posit.air-vscode",
    "editor.formatOnSave": true
  },
  "positron.r.customBinaries": [
    "/opt/R/4.5.1/lib/R/bin/R"
  ],
  "positron.r.customRootFolders": [
    "/data/home/yyx/.uvr/r-versions"
  ],
  "positron.r.interpreters.default": "/opt/R/4.5.1/lib/R/bin/R",
  "positron.r.pipe": "|>",
  "positron.r.useNativePipe": true,
  "r.rpath.linux": "/opt/R/4.5.1/lib/R/bin/R",
  "r.rterm.linux": "/opt/R/4.5.1/lib/R/bin/R"
}